# ==========================================
# Python Backend Exclusions
# ==========================================
# Block the virtual environment completely
backend/venv/
backend/ENV/
backend/env/

# Block private keys and runtime databases
backend/.env
backend/*.db

# Block compiled Python files and temporary audio buffers
backend/__pycache__/
backend/temp_*
backend/*.pyc


# ==========================================
# Flutter Frontend Exclusions
# ==========================================
# Built tools and local configuration files
.dart_tool/
.packages
.pub-cache/
.pub/
build/

# Web/Desktop specific builds
build/
.dart_tool/

# Android/iOS specific local properties
android/**/local.properties
ios/.generated/